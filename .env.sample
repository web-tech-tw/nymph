# http
BASE_URL=""
HTTP_PORT="3000"

# database
MONGODB_URI="mongodb://localhost:27017/nymph"

# openai-compatible integration
OPENAI_API_KEY="your_openai_api_key"
OPENAI_BASE_URL="https://integrate.api.nvidia.com/v1"
OPENAI_MODEL="openai/gpt-oss-20b"
# OPENAI_REASONING_EFFORT="high"  # optional; supported values depend on the model (e.g. low/medium/high, none for Qwen)

# discord integration
DISCORD_BOT_TOKEN="your_discord_bot_token"

# line integration
LINE_CHANNEL_ACCESS_TOKEN="your_line_channel_access_token"
LINE_CHANNEL_SECRET="your_line_channel_secret"

# mcp integration (Model Context Protocol)
# MCP configuration is loaded from a TOML file (default: `./mcp.toml`).
# Copy `mcp.toml.sample` to `mcp.toml` to configure MCP servers.
# MCP_CONFIG_PATH="./mcp.toml"

# sara identity integration
SARA_INTE_HOST="https://web-tech.tw/sara"
SARA_RECV_HOST="https://web-tech.tw/recv/sara"
